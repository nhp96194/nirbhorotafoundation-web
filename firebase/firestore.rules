rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /stories/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /videos/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /faqs/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /volunteers/{docId} {
      allow create: if isValidString(request.resource.data.fullName, 2, 120)
                    && isValidString(request.resource.data.email, 5, 150)
                    && isValidString(request.resource.data.phone, 6, 30)
                    && request.resource.data.consent == true
                    && request.resource.data.status == "new";
      allow read, update, delete: if isAdmin();
    }

    match /contactMessages/{docId} {
      allow create: if isValidString(request.resource.data.name, 2, 120)
                    && isValidString(request.resource.data.email, 5, 150)
                    && isValidString(request.resource.data.message, 5, 2000)
                    && request.resource.data.status == "unread";
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
