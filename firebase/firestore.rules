rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Admins = documents in /admins/{uid}, created ONLY by hand in the Firebase console.
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function str(d, k, n) { return d[k] is string && d[k].size() <= n; }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /settings/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /projects/{id}  { allow read: if resource.data.published == true || isAdmin(); allow write: if isAdmin(); }
    match /stories/{id}   { allow read: if resource.data.published == true || isAdmin(); allow write: if isAdmin(); }
    match /gallery/{id}   { allow read: if resource.data.published == true || isAdmin(); allow write: if isAdmin(); }
    match /volunteers/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','location','interests','skills','availability','intro','status','createdAt'])
        && str(request.resource.data,'name',200) && str(request.resource.data,'email',200) && str(request.resource.data,'phone',200)
        && str(request.resource.data,'location',200) && str(request.resource.data,'interests',200) && str(request.resource.data,'skills',200)
        && str(request.resource.data,'availability',200) && str(request.resource.data,'intro',1500)
        && request.resource.data.status == 'new' && request.resource.data.createdAt == request.time;
    }
    match /contactMessages/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name','email','subject','message','status','createdAt'])
        && str(request.resource.data,'name',200) && str(request.resource.data,'email',200) && str(request.resource.data,'subject',200) && str(request.resource.data,'message',1500)
        && request.resource.data.status == 'new' && request.resource.data.createdAt == request.time;
    }
  }
}
